{
  "name": "ai-portfolio-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:reset": "tsx server/db/migrate.ts --reset",
    "db:sync-config": "tsx server/db/migrate.ts --config-only",
    "db:migrate-skills-field": "tsx server/db/migrate-employee-skills.ts",
    "db:migrate-drop-skill-matrix": "tsx server/db/migrate-drop-skill-matrix.ts",
    "db:migrate-add-project-manager": "tsx server/db/migrate-add-project-manager.ts",
    "db:migrate-add-linked-project": "tsx server/db/migrate-add-linked-project.ts",
    "db:migrate-schema": "tsx server/db/applyMigrations.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@hookform/resolvers": "^5.0.0",
    "@tanstack/react-table": "^8.21.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "lucide-react": "^0.525.0",
    "radix-ui": "^1.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^3.1.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.0.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
